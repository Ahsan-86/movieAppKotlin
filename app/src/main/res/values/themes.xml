<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Thin XML shell theme: Compose (ui/theme/Theme.kt) owns all real theming.
         This just sets the window background before the first Compose frame draws. -->
    <style name="Theme.MovieApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
    </style>
</resources>
